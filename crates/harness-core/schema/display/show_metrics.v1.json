{
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "fallback_text"],
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "string", "minLength": 1, "maxLength": 24 },
          "change_percent": { "type": "number", "minimum": -10000, "maximum": 10000 },
          "lower_is_better": { "type": "boolean" },
          "trend": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "type": "number" } },
          "hint": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "fallback_text": { "type": "string", "minLength": 1, "maxLength": 4000 }
  }
}
