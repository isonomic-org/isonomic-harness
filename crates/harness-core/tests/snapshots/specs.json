[
  {
    "name": "show_table",
    "description": "Show a table of rows and columns the person can sort. Use for comparisons of 3 or more items.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "numeric": {
                "type": "boolean"
              },
              "title": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              "total": {
                "type": "boolean"
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "fallback_text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 120,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "sort": {
          "additionalProperties": false,
          "properties": {
            "ascending": {
              "type": "boolean"
            },
            "column": {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "column"
          ],
          "type": "object"
        },
        "title": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows",
        "fallback_text"
      ],
      "type": "object"
    },
    "kind": "display",
    "concurrency": "parallel"
  },
  {
    "name": "show_steps",
    "description": "Show a short list of steps and where each one stands. Use for plans, procedures and progress.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "fallback_text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "maxLength": 120,
                "type": "string"
              },
              "state": {
                "enum": [
                  "done",
                  "current",
                  "pending",
                  "failed"
                ],
                "type": "string"
              },
              "substeps": {
                "items": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 6,
                "type": "array"
              },
              "title": {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "steps",
        "fallback_text"
      ],
      "type": "object"
    },
    "kind": "display",
    "concurrency": "parallel"
  },
  {
    "name": "show_metrics",
    "description": "Show 1 to 6 headline figures side by side, each with an optional change. Use for summaries of numbers.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "fallback_text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "metrics": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "change_percent": {
                "maximum": 10000,
                "minimum": -10000,
                "type": "number"
              },
              "hint": {
                "maxLength": 80,
                "type": "string"
              },
              "label": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              "lower_is_better": {
                "type": "boolean"
              },
              "trend": {
                "items": {
                  "type": "number"
                },
                "maxItems": 24,
                "minItems": 2,
                "type": "array"
              },
              "value": {
                "maxLength": 24,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "metrics",
        "fallback_text"
      ],
      "type": "object"
    },
    "kind": "display",
    "concurrency": "parallel"
  },
  {
    "name": "show_chart",
    "description": "Show one series of labelled values as a bar, line or area chart. Use when the shape of the numbers matters.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "fallback_text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "bar",
            "line",
            "area"
          ],
          "type": "string"
        },
        "points": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "maxLength": 24,
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 60,
          "minItems": 2,
          "type": "array"
        },
        "series": {
          "maxLength": 40,
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "points",
        "fallback_text"
      ],
      "type": "object"
    },
    "kind": "display",
    "concurrency": "parallel"
  },
  {
    "name": "list_dir",
    "description": "List a folder: one line per entry with its size and date. An empty path lists the linked folders.",
    "input_schema": {
      "properties": {
        "after": {
          "description": "Continue after this name, from the last listing",
          "type": "string"
        },
        "path": {
          "description": "A folder, like Design/icons; empty for the linked folders",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "reads_private_data"
    ],
    "concurrency": "parallel",
    "scope": "folder"
  },
  {
    "name": "read_file",
    "description": "Read a text file, as much as fits. The header says which lines are shown and where to go on.",
    "input_schema": {
      "properties": {
        "from_line": {
          "description": "First line to show, from 1",
          "type": "integer"
        },
        "lines": {
          "description": "How many lines to show at most",
          "type": "integer"
        },
        "path": {
          "description": "A linked folder's name, then the path inside it, like Design/notes.md",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "reads_private_data",
      "ingests_untrusted_content"
    ],
    "concurrency": "parallel",
    "scope": "folder"
  },
  {
    "name": "search_files",
    "description": "Find files by name, or lines that contain some plain text, under a folder.",
    "input_schema": {
      "properties": {
        "in": {
          "description": "names or text; names when left out",
          "type": "string"
        },
        "path": {
          "description": "The folder to search, like Design",
          "type": "string"
        },
        "query": {
          "description": "The name or the text to find",
          "type": "string"
        }
      },
      "required": [
        "path",
        "query"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "reads_private_data",
      "ingests_untrusted_content"
    ],
    "concurrency": "parallel",
    "scope": "folder"
  },
  {
    "name": "write_file",
    "description": "Create or replace a text file with the whole text, or add text to its end.",
    "input_schema": {
      "properties": {
        "append": {
          "description": "Add to the end instead of replacing",
          "type": "boolean"
        },
        "path": {
          "description": "A linked folder's name, then the path inside it, like Design/notes.md",
          "type": "string"
        },
        "text": {
          "description": "The whole new text, or the text to add",
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "modifies_data"
    ],
    "concurrency": "serial",
    "scope": "folder"
  },
  {
    "name": "edit_file",
    "description": "Replace one place in a text file. find must match exactly one place; give more lines if it matches more.",
    "input_schema": {
      "properties": {
        "find": {
          "description": "The text to find, copied from the file",
          "type": "string"
        },
        "path": {
          "description": "A linked folder's name, then the path inside it, like Design/notes.md",
          "type": "string"
        },
        "replace": {
          "description": "What to put in its place",
          "type": "string"
        }
      },
      "required": [
        "path",
        "find",
        "replace"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "modifies_data"
    ],
    "concurrency": "serial",
    "scope": "folder"
  },
  {
    "name": "move_path",
    "description": "Move or rename a file or folder inside one linked folder. Never replaces what is there.",
    "input_schema": {
      "properties": {
        "from": {
          "description": "What to move, like Design/old.md",
          "type": "string"
        },
        "to": {
          "description": "Where it goes, like Design/new.md",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "modifies_data"
    ],
    "concurrency": "serial",
    "scope": "folder"
  },
  {
    "name": "trash_path",
    "description": "Move a file or folder to the Trash, where the person can get it back.",
    "input_schema": {
      "properties": {
        "path": {
          "description": "A linked folder's name, then the path inside it, like Design/notes.md",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "kind": "engine",
    "effects": [
      "modifies_data"
    ],
    "concurrency": "serial",
    "scope": "folder"
  }
]
